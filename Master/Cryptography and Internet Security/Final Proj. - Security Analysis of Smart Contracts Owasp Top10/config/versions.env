# versions.env — Versões pinadas de todas as ferramentas de análise
# Usar em conjunto com setup.sh para garantir ambiente idêntico entre máquinas.
# Atualizar este ficheiro se mudar uma versão (e re-correr setup.sh em todas as máquinas).

# --- Python tools ---
SLITHER_VERSION="0.10.4"
MYTHRIL_VERSION="0.24.8"
SEMGREP_VERSION="1.75.0"
HALMOS_VERSION="0.2.1"
SOLC_VERSION="0.8.20"
# Manticore REMOVIDO: pysha3 não compila em Python 3.12+. Ferramenta abandonada desde 2022.
# MANTICORE_VERSION="0.3.7"

# SmartCheck REMOVIDO: JAR compilado para Java 8, falha em Java 11+ (javax.xml.bind removido).

# --- npm tools ---
SOLHINT_VERSION="5.0.3"

# --- Binários Linux (Echidna, Medusa) ---
# Echidna — https://github.com/crytic/echidna/releases
ECHIDNA_VERSION="2.3.2"
ECHIDNA_URL="https://github.com/crytic/echidna/releases/download/v${ECHIDNA_VERSION}/echidna-${ECHIDNA_VERSION}-x86_64-linux.tar.gz"

# Medusa — https://github.com/crytic/medusa/releases
MEDUSA_VERSION="1.5.1"
MEDUSA_URL="https://github.com/crytic/medusa/releases/download/v${MEDUSA_VERSION}/medusa-linux-x64.tar.gz"

# --- Foundry ---
# Instalado via foundryup (usa stable channel).
FOUNDRY_VERSION="1.5.1-stable"

# --- Aderyn ---
ADERYN_VERSION="0.6.8"
ADERYN_URL="https://github.com/cyfrin/aderyn/releases/download/aderyn-v${ADERYN_VERSION}/aderyn-x86_64-unknown-linux-gnu.tar.xz"
